{
  "name": "collaborative-editor",
  "version": "1.0.0",
  "description": "Real-time collaborative rich text editor using Yjs and TipTap",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "npm run test:server && npm run test:client",
    "test:watch": "concurrently \"npm run test:server:watch\" \"npm run test:client:watch\"",
    "test:server": "REDIS_HOST=localhost jest --runInBand --forceExit",
    "test:server:watch": "REDIS_HOST=localhost jest --watch",
    "test:coverage": "REDIS_HOST=localhost jest --runInBand --coverage",
    "test:client": "cd client && npm run test",
    "test:client:watch": "cd client && npm run test:watch",
    "test:collab": "node test-collaboration.js",
    "init-db": "node script/init-db.js",
    "migrate": "node -e \"require('./script/setup-db-env.js'); require('child_process').execSync('node-pg-migrate up', {stdio: 'inherit'})\"",
    "migrate:down": "node -e \"require('./script/setup-db-env.js'); require('child_process').execSync('node-pg-migrate down', {stdio: 'inherit'})\"",
    "migrate:create": "node-pg-migrate create",
    "migrate:redo": "node -e \"require('./script/setup-db-env.js'); require('child_process').execSync('node-pg-migrate redo', {stdio: 'inherit'})\""
  },
  "keywords": [
    "collaborative",
    "editor",
    "yjs",
    "tiptap"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "express": "^4.18.2",
    "fontoxpath": "^3.34.0",
    "google-auth-library": "^10.5.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "ws": "^8.14.2",
    "y-websocket": "^1.5.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@jest/test-sequencer": "^30.2.0",
    "@types/jest": "^29.5.11",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "node-pg-migrate": "^8.0.3",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/client/"
    ],
    "collectCoverageFrom": [
      "server/**/*.js",
      "!server/**/*.test.js",
      "!server/__tests__/**"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/client/",
      "/test-data/",
      "/__tests__/"
    ],
    "globalSetup": "<rootDir>/server/__tests__/globalSetup.js",
    "setupFilesAfterEnv": [
      "<rootDir>/server/__tests__/setup.js"
    ]
  }
}
