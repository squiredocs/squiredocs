{
  "name": "collaborative-editor",
  "version": "1.0.0",
  "description": "Real-time collaborative rich text editor using Yjs and TipTap",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "npm run test:server && npm run test:client",
    "test:watch": "concurrently \"npm run test:server:watch\" \"npm run test:client:watch\"",
    "test:server": "REDIS_HOST=${REDIS_HOST:-localhost} jest --runInBand --forceExit --silent --reporters=./script/jest-llm-reporter.js",
    "test:server:watch": "REDIS_HOST=${REDIS_HOST:-localhost} jest --watch",
    "test:coverage": "REDIS_HOST=${REDIS_HOST:-localhost} jest --runInBand --coverage",
    "test:client": "cd client && npx vitest run --reporter=../script/vitest-llm-reporter.mjs",
    "test:client:watch": "cd client && npm run test:watch",
    "test:collab": "node test-collaboration.js",
    "init-db": "node script/init-db.js",
    "migrate": "node script/migrate.js",
    "migrate:down": "node -e \"require('./script/setup-db-env.js'); require('child_process').execSync('node-pg-migrate down', {stdio: 'inherit'})\"",
    "migrate:create": "node-pg-migrate create",
    "migrate:redo": "node -e \"require('./script/setup-db-env.js'); require('child_process').execSync('node-pg-migrate redo', {stdio: 'inherit'})\"",
    "build:sandbox-bundle": "node server/mcp/sandbox/build-isolate-bundle.js"
  },
  "keywords": [
    "collaborative",
    "editor",
    "yjs",
    "tiptap"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/google": "^3.0.51",
    "@ai-sdk/openai": "^3.0.73",
    "@ai-sdk/openai-compatible": "^2.0.56",
    "@aws-sdk/client-s3": "^3.1074.0",
    "@aws-sdk/s3-request-presigner": "^3.1074.0",
    "ai": "^6.0.116",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "diff": "^8.0.4",
    "dompurify": "^3.4.11",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "express": "^4.18.2",
    "fontoxpath": "^3.34.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "isolated-vm": "^6.1.2",
    "jsdom": "^24.1.3",
    "jsonwebtoken": "^9.0.3",
    "mermaid": "^11.15.0",
    "node-pg-migrate": "^8.0.3",
    "nodemailer": "^8.0.1",
    "pg": "^8.16.3",
    "prosemirror-model": "^1.19.0",
    "sanitize-html": "^2.17.2",
    "undici": "^7.22.0",
    "ws": "^8.14.2",
    "y-prosemirror": "^1.2.0",
    "y-websocket": "^1.5.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@jest/test-sequencer": "^30.2.0",
    "@types/jest": "^29.5.11",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/client/"
    ],
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ]
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(@ai-sdk|@workflow)/)"
    ],
    "collectCoverageFrom": [
      "server/**/*.js",
      "!server/**/*.test.js",
      "!server/__tests__/**"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/client/",
      "/test-data/",
      "/__tests__/"
    ],
    "globalSetup": "<rootDir>/server/__tests__/globalSetup.js",
    "setupFilesAfterEnv": [
      "<rootDir>/server/__tests__/setup.js"
    ]
  }
}
