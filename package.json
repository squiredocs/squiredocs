{
  "name": "collaborative-editor",
  "version": "1.0.0",
  "description": "Real-time collaborative rich text editor using Yjs and TipTap",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "npm run test:server && npm run test:client:ci",
    "test:watch": "concurrently \"npm run test:server:watch\" \"npm run test:client:watch\"",
    "test:server": "jest",
    "test:server:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:client": "cd client && npm run test:ci",
    "test:client:watch": "cd client && npm test",
    "test:client:ci": "cd client && npm run test:ci",
    "test:collab": "node test-collaboration.js"
  },
  "keywords": [
    "collaborative",
    "editor",
    "yjs",
    "tiptap"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "level": "^9.0.0",
    "ws": "^8.14.2",
    "y-leveldb": "^0.2.0",
    "y-websocket": "^1.5.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/client/"
    ],
    "collectCoverageFrom": [
      "server/**/*.js",
      "!server/**/*.test.js",
      "!server/__tests__/**"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/client/",
      "/test-data/",
      "/__tests__/"
    ],
    "setupFilesAfterEnv": ["<rootDir>/server/__tests__/setup.js"]
  }
}
