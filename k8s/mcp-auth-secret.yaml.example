apiVersion: v1
kind: Secret
metadata:
  name: mcp-auth-secret
  namespace: collab
type: Opaque
stringData:
  # MCP JWT secret for signing agent access tokens
  # Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
  MCP_JWT_SECRET: your-mcp-jwt-secret-here-64-chars

  # MCP refresh token secret for signing refresh tokens
  # Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
  MCP_REFRESH_SECRET: your-mcp-refresh-secret-here-64-chars

  # MCP authorization code secret for hashing auth codes (optional, uses SHA-256 by default)
  # Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
  MCP_AUTH_CODE_SECRET: your-mcp-auth-code-secret-here-64-chars
