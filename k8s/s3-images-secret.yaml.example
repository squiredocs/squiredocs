apiVersion: v1
kind: Secret
metadata:
  name: s3-images-secret
  namespace: collab
type: Opaque
stringData:
  # S3 bucket for document image storage. Use a DEDICATED bucket, separate from
  # the DB-backup bucket (which uses the s3cmd ConfigMap, not this secret).
  # Point this at a separate dev bucket in the dev cluster if desired.
  S3_IMAGE_BUCKET: squiredocs-images

  # AWS region of the bucket
  S3_IMAGE_REGION: us-east-1

  # IAM credentials scoped to the image bucket (s3:PutObject, s3:GetObject,
  # s3:DeleteObject on arn:aws:s3:::squiredocs-images/*). Create a dedicated
  # IAM user — do not reuse the DB-backup credentials.
  AWS_ACCESS_KEY_ID: your-aws-access-key-id
  AWS_SECRET_ACCESS_KEY: your-aws-secret-access-key
