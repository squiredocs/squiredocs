# Dockerfile.backup — dedicated hardened image for the nightly Postgres backup
# CronJob (RD-9). pg_dump + AWS CLI are installed AT BUILD TIME so the runtime
# container does NO package install and runs NON-ROOT. The backup script is baked
# in.
#
# Base: postgres:16-bookworm (glibc/Debian) pinned by digest — it provides
# pg_dump 16 (matching the pgvector/pgvector:pg16 server) AND a glibc runtime, so
# AWS CLI v2 runs (it does not run on Alpine/musl). AWS CLI v2 is required over
# s3cmd because it sends the checksum header S3 Object Lock mandates on every
# PutObject to the immutable backup bucket (s3cmd sends none → 400 InvalidRequest).
FROM postgres:16-bookworm@sha256:92620daddcd947f8d5ab5ba66e848702fe443d87fed30c4cea8e389fd78dfc55

# AWS CLI v2 (baked in; no runtime install). curl/unzip are build-only.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends curl unzip ca-certificates; \
    curl -sSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o /tmp/awscliv2.zip; \
    unzip -q /tmp/awscliv2.zip -d /tmp; \
    /tmp/aws/install; \
    rm -rf /tmp/awscliv2.zip /tmp/aws; \
    apt-get purge -y --auto-remove unzip curl; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    aws --version

# Non-root runtime user (uid/gid 65532 — matches the CronJob securityContext).
# NOTE: the Debian base already has a `backup` group (gid 34), so use a distinct
# name; only the numeric 65532 matters (the pod runs runAsUser/runAsGroup 65532).
RUN groupadd -g 65532 nonroot && useradd -u 65532 -g 65532 -M -s /usr/sbin/nologin nonroot

# Bake the backup script in (no runtime fetch).
COPY --chmod=0555 script/backup-postgres.sh /usr/local/bin/backup-postgres.sh

USER 65532:65532

ENTRYPOINT ["/bin/sh", "/usr/local/bin/backup-postgres.sh"]
