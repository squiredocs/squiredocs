# Server Configuration
PORT=3001
# The Docker image defaults NODE_ENV=production; npm run dev uses this file.
NODE_ENV=development

# Instance mode (feature 059). local (the default when unset): one owner who
# signs in with links from `squire claim-link`; sign-up is closed and Google is
# off. team: Google sign-in (GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET below are
# required) and a first sign-in creates an account. Development and the hosted
# service run in team mode.
SQUIRE_MODE=team

# Instance configuration (feature 058; contract: specs/058-self-host-config/contracts/environment.md)
# Public origin. Default: CLIENT_URL, else http://localhost:${PORT:-3001}.
# Drives the cookie Secure flag (https only), the default Google callback,
# welcome-doc and MCP fallback URLs, and the OpenRouter referer.
# APP_URL=http://localhost:3001
# Hosted-service surfaces (marketing/legal/blog pages, analytics, signup credit
# cap, admin sign-up/login emails, welcome-email and self-test admin actions).
# Default off. The app-dev pod sets it to true.
# SQUIRE_HOSTED=false
# Data directory for generated secrets (secrets.json) and local image bytes
# (images/). Absolute path. Image default /data. Losing it loses the BYOK
# encryption key when that key was generated.
# SQUIRE_DATA_DIR=/local-dev/.squire-data
# Run migrations under an advisory lock before the server loads (image
# entrypoint only; npm run dev never migrates). Default true.
# MIGRATE_ON_BOOT=true
# Image storage driver: local or s3. Default: s3 when S3_IMAGE_BUCKET is set,
# else local (bytes under ${SQUIRE_DATA_DIR}/images).
# STORAGE_DRIVER=local
# Canonical origin returned for hosted alias hosts. Default: APP_URL.
# PUBLIC_ORIGIN=

# Database Configuration
DATABASE_URL=postgres://localhost:5432/collab_db
# Or individual settings:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=collab_db
# DB_USER=postgres
# DB_PASSWORD=

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Default: ${APP_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Secrets (generate strong random strings for production)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The image entrypoint generates any of ACCESS_TOKEN_SECRET,
# REFRESH_TOKEN_SECRET, MCP_JWT_SECRET, API_KEY_ENCRYPTION_KEY that is unset
# into ${SQUIRE_DATA_DIR}/secrets.json; an environment value always wins.
# npm run dev does not generate them.
ACCESS_TOKEN_SECRET=your_access_token_secret_here_min_32_chars
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_min_32_chars
# MCP_JWT_SECRET=
# API_KEY_ENCRYPTION_KEY=   (64 hex characters)

# Client URL (for CORS and redirects). Default: APP_URL. Keep the Vite origin
# for development.
CLIENT_URL=http://localhost:5173

# Email (optional; with no SMTP_FROM email is off and the server logs that once)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465                  # default 465
# SMTP_SECURE=true               # default: true for 465, false (STARTTLS) otherwise
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
# ADMIN_EMAIL=you@example.com
# SES aliases (the hosted service): the generic SMTP_* name wins when both are
# set. Configured only through these, the host defaults to
# email-smtp.us-west-2.amazonaws.com.
# SES_FROM_EMAIL=no-reply@squiredocs.com
# SES_SMTP_USER=your-ses-smtp-username
# SES_SMTP_PASS=your-ses-smtp-password
# SES_SMTP_HOST=email-smtp.us-west-2.amazonaws.com

# Document Image Storage (S3) — optional; with no bucket, images use the local
# driver (STORAGE_DRIVER above). Use a DEDICATED bucket, separate from the
# DB-backup bucket. S3_ENDPOINT selects an S3-compatible service (MinIO, R2)
# with path-style addressing.
# S3_ENDPOINT=http://minio:9000
# S3_IMAGE_BUCKET=squiredocs-images-dev
# S3_IMAGE_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# WebSocket Connection Simulator (for testing flaky connections)
# Uncomment to enable simulation of network issues
# WS_SIMULATE_FLAKY=true
# WS_MIN_DELAY=100                # Min message delay in ms
# WS_MAX_DELAY=2000               # Max message delay in ms
# WS_DROP_RATE=0.1                # Connection drop probability (0.0-1.0)
# WS_PACKET_LOSS=0.05             # Message drop probability (0.0-1.0)
# WS_DROP_INTERVAL_MIN=5000       # Min time between drops in ms
# WS_DROP_INTERVAL_MAX=15000      # Max time between drops in ms
# See docs/websocket-simulator.md for details
